NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=
NUXT_SUPABASE_SECRET_KEY=

# Public origin of the deployed app (no trailing slash). Used to build the
# Instagram OAuth redirect URI and absolute order links in DMs.
NUXT_PUBLIC_APP_URL=

# Meta App Dashboard → Instagram → "API setup with Instagram login".
# These are the *Instagram* app id/secret, not the Facebook ones.
NUXT_INSTAGRAM_APP_ID=
NUXT_INSTAGRAM_APP_SECRET=
# Any random string; paste the same value into the webhook config in Meta.
NUXT_INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
